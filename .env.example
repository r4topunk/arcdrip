# Placeholders only. Copy to .env (gitignored). NEVER commit real keys, seeds or keystore passwords.
# fish: load single values ad hoc with `env VAR=value <cmd>`; never paste keys into the shell history.

# --- network ---
# ARC_RPC also enables the read-only fork tests in contracts/test/fork (skipped when unset).
ARC_RPC=https://rpc.mainnet.arc.io
ARC_TESTNET_RPC=https://rpc.testnet.arc.io
USDC_ADDRESS=0x3600000000000000000000000000000000000000

# --- deploy (Foundry encrypted keystores, see DEPLOY.md) ---
# Create once per wallet (prompts for the key and a password; nothing lands in the repo):
#   cast wallet import arcdrip-deployer --interactive
#   forge script script/Deploy.s.sol --rpc-url arc --account $DEPLOYER_ACCOUNT --sender $DEPLOYER_ADDRESS --broadcast
DEPLOYER_ACCOUNT=arcdrip-deployer
DEPLOYER_ADDRESS=[DEPLOYER_ADDRESS]

# --- e2e (scripts/e2e-testnet.ts, PRD 8.4): three keystores; wallet 1 may be the deployer ---
# Only keystore NAMES live here. The key itself stays in ~/.foundry/keystores and is decrypted by `cast`.
WALLET1_ACCOUNT=arcdrip-deployer
WALLET2_ACCOUNT=arcdrip-wallet-b
WALLET3_ACCOUNT=arcdrip-wallet-c
# Optional: where the keystores are, and password files for an unattended `pnpm e2e:testnet --wait`.
# Without them cast prompts on the terminal. Keep any password file outside the repo, mode 600 (DEPLOY.md 1.3).
KEYSTORE_DIR=
KEYSTORE_PASSWORD_FILE=
WALLET1_PASSWORD_FILE=
WALLET2_PASSWORD_FILE=
WALLET3_PASSWORD_FILE=
# Timings of the run. The rate is derived from E2E_DEPOSIT / E2E_RUNWAY_SECONDS, so the freeze lands on schedule.
E2E_DEPOSIT=200000
E2E_RUNWAY_SECONDS=180
E2E_STREAM_SECONDS=45
# A wait longer than this pauses the run; re-running it resumes from scripts/.state/<chainId>.json.
E2E_MAX_WAIT_SECONDS=600

# --- demo wallets (public addresses only, never keys) ---
WALLET_B_ADDRESS=[ADDRESS]
WALLET_C_ADDRESS=[ADDRESS]
# Fourth address added mid-stream by the mainnet proof run (CHECKLIST.md step 5).
OPS_ADDRESS=[ADDRESS]

# --- deployed contract (copy from deployments/arc-*.json after deploy) ---
DRIP_POOL_ADDRESS=[ADDRESS]
DRIP_POOL_DEPLOY_BLOCK=[DEPLOY_BLOCK]
LOG_LEVEL=info

# --- web (baked into the static build) ---
# 5042 = Arc mainnet, 5042002 = Arc testnet
NEXT_PUBLIC_CHAIN_ID=5042
NEXT_PUBLIC_RPC_URL=https://rpc.mainnet.arc.io
NEXT_PUBLIC_DRIP_ADDRESS=[ADDRESS]
NEXT_PUBLIC_DRIP_DEPLOY_BLOCK=[DEPLOY_BLOCK]
NEXT_PUBLIC_EXPLORER_URL=https://explorer.arc.io
NEXT_PUBLIC_SITE_URL=https://r4topunk.github.io/sharedarc
NEXT_PUBLIC_REPO_URL=https://github.com/r4topunk/sharedarc
# Empty for local dev; the Pages build sets /sharedarc.
NEXT_PUBLIC_BASE_PATH=
